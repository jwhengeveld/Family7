<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      AppCompat als basis: de Cast-knop opent zijn apparatenkiezer als
      dialoogvenster van AppCompat. De rest van het scherm tekent Compose.
    -->
    <style name="Theme.Family7Mobile" parent="Theme.AppCompat.NoActionBar">
        <item name="colorPrimary">@color/family7_red</item>
        <item name="colorPrimaryDark">@color/family7_blue_dark</item>
        <item name="colorAccent">@color/family7_red</item>
        <item name="android:windowBackground">@color/family7_blue_dark</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <!--
      Het systeem-splashscherm: het embleem op Family7-blauw. Daarna neemt het
      geanimeerde splashscherm in de app (Family7Splash) het op precies die plek over.
    -->
    <style name="Theme.Family7Mobile.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/family7_blue_dark</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_emblem</item>
        <item name="postSplashScreenTheme">@style/Theme.Family7Mobile</item>
    </style>
</resources>
