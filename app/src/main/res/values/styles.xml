<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Family7TV" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">#031A38</item>
        <item name="android:colorPrimary">#03326C</item>
        <item name="android:colorAccent">#F47C20</item>
    </style>

    <!--
      Het systeem-splashscherm: het embleem op Family7-blauw. Daarna neemt het
      geanimeerde splashscherm in de app (Family7Splash) het op precies die plek over.
    -->
    <style name="Theme.Family7TV.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#031A38</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_emblem</item>
        <item name="postSplashScreenTheme">@style/Theme.Family7TV</item>
    </style>
</resources>
